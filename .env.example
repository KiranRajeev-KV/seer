# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Seer ML service. Use an HTTPS URL outside local development; localhost HTTP
# is accepted only for the local deployment spike.
ML_SERVICE_BASE_URL=http://127.0.0.1:8080
ML_SERVICE_API_KEY=replace-with-a-long-random-secret
ML_SERVICE_TIMEOUT_MS=120000

# CSV profiling limits enforced by the ML service.
ML_PROFILE_MAX_CSV_BYTES=5242880
ML_PROFILE_MAX_CSV_ROWS=20000
ML_PROFILE_MAX_CSV_COLUMNS=50
ML_PROFILE_MAX_CATEGORICAL_VALUES=50
ML_PROFILE_SAMPLE_ROWS=10

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
